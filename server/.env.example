NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Required when the deployment only has the public Supabase client configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional but recommended: enables immediate confirmation after registration.
