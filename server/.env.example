NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Required when the deployment only has the public Supabase client configured.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional but recommended: enables immediate confirmation after registration.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=dev-secret
CLIENT_URL=http://localhost:5173

# Firebase admin credentials for server-side Firebase token verification.
# Either store the JSON directly in FIREBASE_SERVICE_ACCOUNT_KEY or path in FIREBASE_SERVICE_ACCOUNT_PATH.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
