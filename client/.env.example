# Supabase project credentials (set BOTH — the app reads whichever is present)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Also accepted as NEXT_PUBLIC_ prefixes for legacy compatibility
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Base URL of the FRONTEND used when building password-reset email links.
# Local dev:  http://localhost:5173
# Production: https://collage-navigator-client.vercel.app
VITE_SITE_URL=http://localhost:5173
